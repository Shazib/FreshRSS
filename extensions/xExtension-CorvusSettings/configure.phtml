<?php
	declare(strict_types=1);
	/** @var CorvusSettingsExtension $this */
?>
<p><?= _t('ext.corvus_settings.intro') ?></p>
<?php if (FreshRSS_Context::userConf()->theme !== 'Corvus') { ?>
	<p class="alert alert-warn"><?= _t('ext.corvus_settings.inactive') ?></p>
<?php } ?>
<?php if ($this->errors !== []) { ?>
	<p role="alert" class="alert alert-error"><?= _t('ext.corvus_settings.invalid') ?>
		<?php foreach ($this->errors as $key) { ?>
			<?= htmlspecialchars(_t('ext.corvus_settings.' . $key), ENT_QUOTES, 'UTF-8') ?>;
		<?php } ?>
	</p>
<?php } ?>
<form class="corvus-settings-form" action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post" data-auto-leave-validation="1">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<?php foreach (CorvusSettingsExtension::FIELDS as $group => $fields) { ?>
		<fieldset>
			<legend><?= _t('ext.corvus_settings.' . $group) ?></legend>
			<?php if ($group === 'interface' || $group === 'reader') {
				$key = $group === 'interface' ? 'ui_font' : 'article_font'; ?>
				<div class="form-group">
					<label class="group-name" for="corvus-<?= $key ?>"><?= _t('ext.corvus_settings.' . $key) ?></label>
					<div class="group-controls">
						<select name="<?= $key ?>" id="corvus-<?= $key ?>">
							<?php foreach (CorvusSettingsExtension::FONTS as $font => $stack) { ?>
								<option value="<?= $font ?>"<?= $this->values[$key] === $font ? ' selected' : '' ?>><?= _t('ext.corvus_settings.font_' . $font) ?></option>
							<?php } ?>
						</select>
					</div>
				</div>
			<?php } ?>
			<?php foreach ($fields as $key => $field) { ?>
				<div class="form-group">
					<label class="group-name" for="corvus-<?= $key ?>"><?= _t('ext.corvus_settings.' . $key) ?></label>
					<div class="group-controls">
						<input type="number" id="corvus-<?= $key ?>" name="<?= $key ?>"
							value="<?= htmlspecialchars($this->values[$key], ENT_QUOTES, 'UTF-8') ?>" min="<?= $field['min'] ?>" max="<?= $field['max'] ?>" step="<?= $field['step'] ?>" required="required"
							aria-describedby="corvus-help-<?= $key ?>" />
						<span id="corvus-help-<?= $key ?>"><?= _t('ext.corvus_settings.help_' . $key) ?></span>
					</div>
				</div>
			<?php } ?>
		</fieldset>
	<?php } ?>
	<div class="form-group form-actions">
		<div class="group-controls">
			<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
			<button type="submit" class="btn" name="preset" value="reset" formnovalidate="formnovalidate"><?= _t('ext.corvus_settings.reset') ?></button>
		</div>
	</div>
</form>
